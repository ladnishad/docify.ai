{
  "name": "docify",
  "version": "1.0.0",
  "description": "Turn any public documentation URL into a clean, AI-friendly Markdown file",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "tsc && cd frontend && npm run build",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "install:frontend": "cd frontend && npm install"
  },
  "keywords": [
    "documentation",
    "markdown",
    "converter",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "playwright": "^1.40.1",
    "turndown": "^7.1.2",
    "turndown-plugin-gfm": "^1.0.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/turndown": "^5.0.4",
    "@types/cors": "^2.8.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
